MONGO_URI=mongodb://localhost:27017
DB_NAME=credit_db
# Set a long random secret for persistent sessions across restarts and workers.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
SENDER_EMAIL=
SENDER_PASSWORD=
# Optional. Credit planning tools work without Gemini.
GEMINI_API_KEY=
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
